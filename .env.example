# Copy to .env and fill in what you use. Every provider is optional:
# with none set, only local Ollama models work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=        # free tier: aistudio.google.com (used by the gemini models)

# Unset = conversations kept in memory only. With `docker compose up -d`:
DATABASE_URL=postgresql+asyncpg://alpha:alpha@localhost:5433/alpha

# OLLAMA_BASE_URL=http://localhost:11434
# ASSISTANT_NAME=Assistant
# WAKE_WORD=           # defaults to ASSISTANT_NAME; pick something distinctive to say
